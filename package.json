{
  "name": "the-tech-guider-hub",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "description": "The Tech Guider Hub - official resource hub for The Tech Guider YouTube channel",
  "scripts": {
    "setup": "node server/scripts/owner-cli.js init",
    "owner:change": "node server/scripts/owner-cli.js change",
    "owner:hash": "node server/scripts/owner-cli.js hash",
    "seed": "node server/seed.js",
    "dev": "npm run build && cross-env NODE_ENV=development node server/index.js",
    "build": "vite build && node scripts/copy-ai.mjs",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "test": "node server/scripts/test-api.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@google/generative-ai": "^0.24.1",
    "@libsql/client": "^0.18.0",
    "@tanstack/react-query": "^5.104.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "googleapis": "^144.0.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.12.1",
    "motion": "^14.1.0",
    "multer": "^2.4.0",
    "nanoid": "^5.0.7",
    "nodemailer": "^10.1.1",
    "openai": "^7.33.0",
    "otplib": "^13.5.0",
    "qrcode": "^1.5.4",
    "react-hook-form": "^7.91.0",
    "react-loading-skeleton": "^3.5.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "serverless-http": "^3.2.0",
    "sonner": "^2.0.8",
    "swiper": "^14.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.15",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "framer-motion": "^11.1.7",
    "lucide-react": "^0.475.0",
    "postcss": "^8.4.31",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^7.0.2",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
