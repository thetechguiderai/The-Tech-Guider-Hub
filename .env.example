# The Tech Guider Hub - environment configuration
# Copy this file to `.env` and fill in your real values.
# Never commit `.env`. Everything here must stay secret.

# HTTP port for the server
PORT=4500

# Long random string used to sign session cookies (generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
SESSION_SECRET=

# Comma-separated list of origins allowed to make API calls (defaults to same-origin)
# CORS_ORIGINS=

# In production set to true so cookies use the Secure flag (requires HTTPS)
COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# OWNER ACCESS CODE (10 digits)
#
# Option A (recommended): run `npm run setup` once. It asks for your 10-digit
# code and stores only its scrypt hash in the database.
#
# Option B: pre-compute a hash and place it below as the initial seed:
#   npm run owner:hash -- 1234567890
# then set OWNER_ACCESS_CODE_HASH=<hash output>
#
# Only the hash may be stored. The plain code is never written or returned.
# ---------------------------------------------------------------------------
OWNER_ACCESS_CODE_HASH=376516af0215125b94345136e5a2a2bc:860e428ab8abb005f38044126a1b4666e85684ba92555104f52d6395a6cd7b04

# ---------------------------------------------------------------------------
# YOUTUBE DATA API (optional)
#
# Leave empty if you have no API key yet. Statistics will show a clean
# "Stats unavailable" state instead of fake numbers.
#
# Create a key at https://console.cloud.google.com/apis/library/youtube.googleapis.com
# ---------------------------------------------------------------------------
YOUTUBE_API_KEY=AIzaSyAoGhvO5qJc01P0uosguDgxEm7Abhc22JI
# YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# THE TECH GUIDER AI (optional override; can also be set from Owner Dashboard)
# ---------------------------------------------------------------------------
AI_URL=

# ---------------------------------------------------------------------------
# Rate limiting (requests per window, and lockout after failed owner logins)
# ---------------------------------------------------------------------------
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=600000
OWNER_MAX_ATTEMPTS=5
OWNER_LOCKOUT_MS=900000