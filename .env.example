# The Tech Guider 01 - environment configuration
# Copy this file to `.env` and fill in your real values.
# Never commit `.env`. Everything here must stay secret.

# HTTP port for the server
PORT=4500

# Long random string used to sign session cookies (generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
SESSION_SECRET=

# Comma-separated list of origins allowed to make API calls (defaults to same-origin)
# CORS_ORIGINS=

# In production set to true so cookies use the Secure flag (requires HTTPS)
COOKIE_SECURE=true

# ---------------------------------------------------------------------------
# OWNER ACCESS CODE (10 digits)
#
# Option A (recommended): run `npm run setup` once. It asks for your 10-digit
# code and stores only its scrypt hash in the database.
#
# Option B: pre-compute a hash and place it below as the initial seed:
#   npm run owner:hash -- 1234567890
# then set OWNER_ACCESS_CODE_HASH=<hash output>
#
# Only the hash may be stored. The plain code is never written or returned.
# NOTE: replace the value below with your own hash before going live.
# ---------------------------------------------------------------------------
OWNER_ACCESS_CODE_HASH=

# ---------------------------------------------------------------------------
# YOUTUBE DATA API (optional)
#
# Leave empty if you have no API key yet. Statistics will show a clean
# "Stats unavailable" state instead of fake numbers.
#
# Create a key at https://console.cloud.google.com/apis/library/youtube.googleapis.com
# ---------------------------------------------------------------------------
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=UCiV1R0WRlNKhr5PIT06uJ5w

# ---------------------------------------------------------------------------
# THE TECH GUIDER AI (built into the Hub, served at /ai)
#
# The AI workspace reuses SESSION_SECRET above and needs at least one model
# provider key. All keys stay server-side and are never sent to the browser.
# ---------------------------------------------------------------------------

# Base path of the mounted AI app. Keep /ai for the Hub.
TG_AI_BASE_PATH=/ai

# ---------------------------------------------------------------------------
# PER-MODEL AI API KEYS POOL
# ---------------------------------------------------------------------------
# Paradise (1 OpenRouter key)
PARADISE_OPENROUTER_1=

# Lite (1 OpenRouter + 1 Google key)
LITE_OPENROUTER_1=
LITE_GOOGLE_1=

# Blaze (2 OpenRouter + 1 Google key)
BLAZE_OPENROUTER_1=
BLAZE_OPENROUTER_2=
BLAZE_GOOGLE_1=

# Titan (2 OpenRouter + 2 Google keys)
TITAN_OPENROUTER_1=
TITAN_OPENROUTER_2=
TITAN_GOOGLE_1=
TITAN_GOOGLE_2=

# Deep (2 OpenRouter + 3 Google keys)
DEEP_OPENROUTER_1=
DEEP_OPENROUTER_2=
DEEP_GOOGLE_1=
DEEP_GOOGLE_2=
DEEP_GOOGLE_3=

# Fallback global provider keys
OPENROUTER_API_KEY=
GOOGLE_API_KEY=

# ---------------------------------------------------------------------------
# GOOGLE OAUTH (Sign in with Google)
# Create credentials in Google Cloud Console -> APIs & Services -> Credentials
# Authorized redirect URI: https://your-domain.com/ai/api/auth/google/callback
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=

# Public base URL used in AI links (share links)
APP_URL=https://theguiderhub.vercel.app

# AI owner account (full access to the AI owner dashboard)
OWNER_EMAIL=itxmeshadow1234@gmail.com
OWNER_PASSWORD=Nihadfatima145

# Managed persistent database for the AI (Vercel's /tmp SQLite does not persist).
# Either set DATABASE_PATH to a persistent path, or configure a Turso database:
TURSO_DATABASE_URL=libsql://ttg-hub-nottoji1.aws-ap-south-1.turso.io
TURSO_AUTH_TOKEN=eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9.eyJhIjoicnciLCJpYXQiOjE3OTI4NjI0OTksImlkIjoiMDFhMTZlZWUtNDIwMS03YmY4LTg1YTktNzIyZDc4MjYwZGJlIiwia2lkIjoiODB2TGFDcF96aURLWUJtMGpNWllnVVZrZm1HNGh0TlBsUjZoU3dXZ0JvcyIsInJpZCI6ImU1OTdiNzU3LTNiYWMtNGEyMi05ZjU3LTg1NzY1OWQ5ZTZkOSJ9.rL4nJz_0g2Fz-zKE_fs9rAdclRZUFlUaT0xTMd9fqtMTgXQFpD8cnPXe5O-SUa0Ca7qmH5584u1wcRF-N8r7AQ
DATABASE_PATH=libsql://ttg-hub-nottoji1.aws-ap-south-1.turso.io

# ---------------------------------------------------------------------------
# Rate limiting (requests per window, and lockout after failed owner logins)
# ---------------------------------------------------------------------------
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=600000
OWNER_MAX_ATTEMPTS=5
OWNER_LOCKOUT_MS=900000